# Production environment template
# Copy to .env.production and set real values. Never commit .env.production.

# Database
POSTGRES_URL=postgresql://user:REPLACE@postgres:5432/chimera
POSTGRES_USER=chimera
POSTGRES_PASSWORD=REPLACE_STRONG_PASSWORD

# Redis
REDIS_URL=redis://redis:6379/0

# Weaviate (if used)
WEAVIATE_URL=http://weaviate:8080
WEAVIATE_API_KEY=REPLACE

# AI / Content
GEMINI_API_KEY=REPLACE
GOOGLE_API_KEY=REPLACE
OPENAI_API_KEY=REPLACE
ANTHROPIC_API_KEY=REPLACE

# News / Trends
NEWSDATA_API_KEY=REPLACE

# App
ENVIRONMENT=production
LOG_LEVEL=INFO
CORS_ORIGINS=https://your-domain.com

# Optional: Coinbase AgentKit, Twitter, etc.
# COINBASE_API_KEY=
# TWITTER_BEARER_TOKEN=
