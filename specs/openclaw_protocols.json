{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "OpenClaw Protocol Definitions (Project Chimera)",
  "description": "Executable protocol schemas for OpenClaw integration. Linked from specs/openclaw_integration.md",
  "definitions": {
    "IdentityProtocol": {
      "type": "object",
      "description": "Agent identity via wallet DID (Coinbase AgentKit)",
      "properties": {
        "did": { "type": "string", "description": "Wallet address as DID" },
        "principal_verification": { "type": "string", "description": "Cryptographic verification of owner" }
      },
      "required": ["did"]
    },
    "CapabilityAdvertisement": {
      "type": "object",
      "description": "MCP resource mcp://chimera/[agent_id]/capabilities",
      "properties": {
        "agent_id": { "type": "string" },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "intent_schema": { "type": "string" },
              "resource_uri": { "type": "string" }
            }
          }
        }
      },
      "required": ["agent_id"]
    },
    "ReputationOracleQuery": {
      "type": "object",
      "description": "Query decentralized ledger for counterparty history",
      "properties": {
        "counterparty_did": { "type": "string" },
        "outcome_types": { "type": "array", "items": { "type": "string" } }
      }
    },
    "NegotiationProtocol": {
      "type": "object",
      "description": "Smart contract templates; CFO Judge validates",
      "properties": {
        "template_id": { "type": "string" },
        "cfo_approved": { "type": "boolean", "default": false },
        "escrow_required": { "type": "boolean" }
      },
      "required": ["template_id"]
    },
    "SecureDataExchange": {
      "type": "object",
      "description": "Permissioned sharing; governed by SOUL.md directives",
      "properties": {
        "usage_constraints": { "type": "array", "items": { "type": "string" } },
        "expiration": { "type": "string", "format": "date-time" }
      }
    }
  }
}
