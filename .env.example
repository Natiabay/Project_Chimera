# ============================================
# PROJECT CHIMERA: ENVIRONMENT CONFIGURATION
# ============================================

# IMPORTANT: For the 3-Day Challenge, use the TEST VALUES below
# For production, replace with real API keys from services

# ====================
# AI MODELS (SRS 2.3)
# ====================

# Google Gemini API
# Get from: https://aistudio.google.com/app/apikey
# Free tier: 60 requests/minute
GEMINI_API_KEY=AIzaSyCtest_key_for_gemini_123

# Anthropic Claude API
# Get from: https://console.anthropic.com/
# Free trial: $5 credit
ANTHROPIC_API_KEY=sk-ant-test_key_for_claude_123

# ====================
# DATABASES (SRS 2.3)
# ====================

# Weaviate Vector Database (FREE for 14 days)
# Create at: https://console.weaviate.cloud/
# Sandbox: Free 14-day cluster
WEAVIATE_URL=https://test-cluster.weaviate.network
WEAVIATE_API_KEY=test-weaviate-key-123

# PostgreSQL (Local for testing)
# Install: brew install postgresql (Mac) or sudo apt install postgresql (Linux)
# Run: createdb chimera
POSTGRES_URL=postgresql://localhost:5432/chimera

# Redis (Local for testing)
# Install: brew install redis (Mac) or sudo apt install redis (Linux)
# Run: redis-server
REDIS_URL=redis://localhost:6379/0

# ====================
# BLOCKCHAIN (FR 5.0)
# ====================

# Coinbase AgentKit (TESTNET for development)
# Get from: https://portal.cdp.coinbase.com/
# Use Base Sepolia testnet for testing
CDP_API_KEY_NAME=test-cdp-key-name
CDP_API_KEY_PRIVATE_KEY=test-private-key-do-not-use-real
BASE_NETWORK_RPC_URL=https://sepolia.base.org

# ====================
# NEWS API (NewsData.io)
# ====================
# Used by skill_fetch_trends. Get key: https://newsdata.io/
NEWSDATA_API_KEY=your_newsdata_api_key_here

# ====================
# SOCIAL MEDIA (TEST)
# ====================

# For testing, use mock/twitter API keys
# Real keys needed for production
TWITTER_BEARER_TOKEN=test_twitter_bearer_token_123
INSTAGRAM_ACCESS_TOKEN=test_instagram_token_123

# ====================
# BUDGET LIMITS (FR 5.2)
# ====================

# Daily spend limits in USDC
MAX_DAILY_SPEND_USDC=50.0
MAX_TRANSACTION_USDC=10.0

# ====================
# CONFIDENCE THRESHOLDS (NFR 1.1)
# ====================

# Auto-approve above 0.90, review 0.70-0.90, reject below 0.70
HIGH_CONFIDENCE_THRESHOLD=0.90
MEDIUM_CONFIDENCE_THRESHOLD=0.70
LOW_CONFIDENCE_THRESHOLD=0.50

# ====================
# MCP CONFIGURATION
# ====================

MCP_HOST=localhost
MCP_PORT=3000

# ============================================
# QUICK SETUP FOR CHALLENGE:
# ============================================
#
# 1. Copy this file to .env:
#    cp .env.example .env
#
# 2. For Weaviate, create FREE cluster:
#    - Go to https://console.weaviate.cloud/
#    - Click "Create Sandbox" (free for 14 days)
#    - Copy URL and API key
#
# 3. For Gemini API, get FREE key:
#    - Go to https://aistudio.google.com/app/apikey
#    - Click "Create API Key"
#    - Free: 60 requests/minute
#
# 4. For testing, use local PostgreSQL/Redis:
#    brew install postgresql redis
#    brew services start postgresql
#    brew services start redis
#    createdb chimera
